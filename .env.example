# 复制本文件为 .env 并填入你自己的真实 Key（.env 已被 .gitignore 忽略，不会上传）
# cp .env.example .env

# 必需：LiteLLM 主密钥，用于管理。请改为一个强随机字符串
LITELLM_MASTER_KEY=sk-your-strong-random-master-key

# 可选：用于加密存储的盐值，设置后不要随意更改
#LITELLM_SALT_KEY=your-salt-key

# 你的各大模型提供商 API Key（从对应平台控制台获取）
ZHIPUAI_API_KEY=your-zhipuai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
MOONSHOT_API_KEY=your-moonshot-kimi-api-key
QIANFAN_ACCESS_KEY=your-qianfan-access-key
QIANFAN_SECRET_KEY=your-qianfan-secret-key
DASHSCOPE_API_KEY=your-dashscope-api-key
